#!/usr/bin/env bash

set -euo pipefail

card="alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"
profile="HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)"
speaker_sink="alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink"

# Give WirePlumber a moment to restore device state before overriding it.
sleep 2

pactl set-card-profile "$card" "$profile"
pactl set-default-sink "$speaker_sink"
