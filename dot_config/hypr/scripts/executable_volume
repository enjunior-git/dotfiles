#!/usr/bin/env bash

set -eu

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/hypr-notify"
mkdir -p "$STATE_DIR"

state_file() {
	printf '%s/%s.id\n' "$STATE_DIR" "$1"
}

send_notification() {
	app_name=$1
	icon=$2
	summary=$3
	body=$4
	value=${5:-}
	state_key=${6:-$app_name}
	id_file=$(state_file "$state_key")
	replace_id=0

	if [ -f "$id_file" ]; then
		replace_id=$(cat "$id_file")
	fi

	if command -v notify-send >/dev/null 2>&1; then
		notify_id=""
		if [ -n "$value" ]; then
			notify_id=$(notify-send \
				-a "$app_name" \
				-p \
				-r "$replace_id" \
				-h "string:x-canonical-private-synchronous:$app_name" \
				-h "int:value:$value" \
				-u low \
				-i "$icon" \
				"$summary" "$body")
		else
			notify_id=$(notify-send \
				-a "$app_name" \
				-p \
				-r "$replace_id" \
				-h "string:x-canonical-private-synchronous:$app_name" \
				-u low \
				-i "$icon" \
				"$summary" "$body")
		fi

		if [ -n "$notify_id" ]; then
			printf '%s\n' "$notify_id" > "$id_file"
		fi
		return
	fi

	if command -v gdbus >/dev/null 2>&1; then
		hints="{}"
		if [ -n "$value" ]; then
			hints="{'value': <int32 $value>}"
		fi
		response=$(gdbus call --session \
			--dest org.freedesktop.Notifications \
			--object-path /org/freedesktop/Notifications \
			--method org.freedesktop.Notifications.Notify \
			"$app_name" \
			"$replace_id" \
			"$icon" \
			"$summary" \
			"$body" \
			[] \
			"$hints" \
			2000)
		new_id=$(printf '%s\n' "$response" | sed -nE "s/^\(uint32 ([0-9]+),\)$/\1/p")
		if [ -n "$new_id" ]; then
			printf '%s\n' "$new_id" > "$id_file"
		fi
	fi
}

get_volume() {
	wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{print int($2 * 100 + 0.5)}'
}

is_muted() {
	wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q "\[MUTED\]"
}

get_icon() {
	current=$(get_volume)
	if is_muted || [ "$current" -eq 0 ]; then
		echo "audio-volume-muted"
	elif [ "$current" -le 30 ]; then
		echo "audio-volume-low"
	elif [ "$current" -le 70 ]; then
		echo "audio-volume-medium"
	else
		echo "audio-volume-high"
	fi
}

notify_user() {
	send_notification "volume" "$(get_icon)" "Volume" "$(get_volume)%" "$(get_volume)"
}

inc_volume() {
	wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && notify_user
}

dec_volume() {
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && notify_user
}

toggle_mute() {
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
	if is_muted; then
		send_notification "volume" "audio-volume-muted" "Volume muted" "" "volume"
	else
		notify_user
	fi
}

toggle_mic() {
	wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
	if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q "\[MUTED\]"; then
		send_notification "microphone" "microphone-sensitivity-muted" "Microphone muted" "" "microphone"
	else
		send_notification "microphone" "audio-input-microphone" "Microphone unmuted" "" "microphone"
	fi
}

if [[ "$1" == "--get" ]]; then
	get_volume
elif [[ "$1" == "--inc" ]]; then
	inc_volume
elif [[ "$1" == "--dec" ]]; then
	dec_volume
elif [[ "$1" == "--toggle" ]]; then
	toggle_mute
elif [[ "$1" == "--toggle-mic" ]]; then
	toggle_mic
elif [[ "$1" == "--get-icon" ]]; then
	get_icon
else
	get_volume
fi
