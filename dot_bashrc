#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

__ensure_ssh_agent() {
    command -v ssh-add >/dev/null 2>&1 || return

    __ssh_agent_available() {
        [ -n "${SSH_AUTH_SOCK:-}" ] || return 1
        ssh-add -l >/dev/null 2>&1
        case $? in
            0|1) return 0 ;;
            *) return 1 ;;
        esac
    }

    __ssh_add_default_key() {
        [ -r "$HOME/.ssh/id_ed25519" ] || return
        ssh-add -l >/dev/null 2>&1 || ssh-add "$HOME/.ssh/id_ed25519" >/dev/null 2>&1
    }

    # Keep a working forwarded agent, such as devsy's container agent.
    if __ssh_agent_available; then
        __ssh_add_default_key
        return
    fi

    local agent_env="$HOME/.ssh/agent.env"

    if [ -r "$agent_env" ]; then
        # shellcheck disable=SC1090
        . "$agent_env" >/dev/null 2>&1
    fi

    if ! __ssh_agent_available; then
        mkdir -p "$HOME/.ssh"
        ssh-agent -s >"$agent_env"
        chmod 600 "$agent_env"
        # shellcheck disable=SC1090
        . "$agent_env" >/dev/null 2>&1
    fi

    __ssh_add_default_key
    unset -f __ssh_agent_available __ssh_add_default_key
}

__ensure_ssh_agent
unset -f __ensure_ssh_agent __ssh_agent_available __ssh_add_default_key

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

if command -v kubectl >/dev/null 2>&1; then
    source <(kubectl completion bash)
    alias k=kubectl
    complete -o default -F __start_kubectl k
fi

EDITOR=vim
TERM=xterm-256color

export DEVSY_DISABLE_TELEMETRY="true"

eval "$(starship init bash)"

### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="$HOME/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)

eval "$(mise activate bash)"
